{
  "description": "mem0-rvaim local memory hooks (SessionStart / UserPromptSubmit / PreToolUse / PreCompact / Stop)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "mem0-ensure-deps",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_deps.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook ensure-deps",
            "timeout": 120
          },
          {
            "name": "mem0-session-start",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on_session_start.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "mem0-user-prompt",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on_user_prompt.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook user-prompt",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "name": "mem0-block-memory-write",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/block_memory_write.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook block-write"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "name": "mem0-pre-compact",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on_pre_compact.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook pre-compact",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "mem0-session-summary",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on_stop.sh\"",
            "commandWindows": "pythonw \"${CLAUDE_PLUGIN_ROOT}\\scripts\\hook_runner.py\" --hook stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}